---
import Layout from "../layouts/Layout.astro";
const topics = [
  "Foundations",
  "Storage Engines",
  "Replication",
  "Partitioning",
  "Transactions & Consistency",
  "Distributed Coordination",
  "Event-Driven Systems",
  "Architecture Patterns",
];
---

<Layout title="Explore. Break. Understand.">
  <section class="hero home-hero">
    <span class="eyebrow">A FIELD GUIDE TO DATA SYSTEMS</span>
    <h1>
      Understand the system.
      <br />
      <em>By changing it.</em>
    </h1>
    <p>
      Make a write. Cut a connection. Read an old value. Explore the trade-offs
      behind the systems you build, one experiment at a time.
    </p>
    <a class="button" href="/replication/stale-reads">
      Start with replication <span aria-hidden="true">↗</span>
    </a>
    <span class="meta">
      03 interactive lessons · Built for curious engineers
    </span>
  </section>
  <section id="atlas" class="atlas-section">
    <div class="section-heading">
      <h2>Your map of data systems</h2>
      <p>Eight territories. One connected view.</p>
    </div>
    <div class="atlas-grid">
      {topics.map((topic, i) => (
        <article class:list={["topic", { available: i === 2 || i === 3 }]}>
          <span class="eyebrow">
            0{i + 1} / {i === 2 || i === 3 ? "EXPLORE NOW" : "ON THE HORIZON"}
          </span>
          <h3>{topic}</h3>
          {i === 2 ? (
            <>
              <p>
                When a successful write and an old read can both be correct.
              </p>
              <a href="/replication/stale-reads">
                Replication and Stale Reads →
              </a>
              <a href="/replication/read-your-writes">Read Your Writes →</a>
            </>
          ) : i === 3 ? (
            <>
              <p>Evenly placed keys can still produce uneven traffic.</p>
              <a href="/partitioning/hotspots">Partitioning and Hotspots →</a>
            </>
          ) : (
            <p>Planned territory</p>
          )}
        </article>
      ))}
    </div>
  </section>
</Layout>
