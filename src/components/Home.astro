---
import Layout from "../layouts/Layout.astro";
import { localeFromPath, localizedPath } from "../i18n";
import { homeCopy as c } from "../content/home";
import TransferDiagram from "./TransferDiagram";
import { estimateTransfer, progressAt } from "../simulation/transfer";
const locale = localeFromPath(Astro.url.pathname);
const preview = estimateTransfer({
  records: 1_000_000,
  reading: "lazy",
  batchSize: 1_000,
});
const previewProgress = progressAt(preview, preview.durationMs * 0.42);
---

<Layout title={c.title} description={c.intro} editorial>
  <div class="atlas-home">
    <section class="atlas-intro">
      <h1>{c.title}</h1>
      <p class="atlas-description">{c.intro}</p>
    </section>
    <section
      id="atlas"
      class="featured-exploration"
      aria-labelledby="exploration-title"
    >
      <div class="featured-copy">
        <p class="story-kicker">{c.index}</p>
        <h2 id="exploration-title">{c.name}</h2>
        <p class="featured-question">{c.question}</p>
        <p class="featured-description">{c.description}</p>
        <a
          class="explore-link"
          href={localizedPath(locale, "/data-transfers/")}
        >
          {c.open}
          <span aria-hidden="true">↗</span>
        </a>
      </div>
      <a
        class="featured-visual"
        href={localizedPath(locale, "/data-transfers/")}
        aria-label={c.open}
        tabindex="-1"
      >
        <TransferDiagram estimate={preview} progress={previewProgress} />
        <span class="visual-caption">{c.path}</span>
      </a>
    </section>
  </div>
</Layout>
