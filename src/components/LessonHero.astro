---
interface Props {
  title: string;
  subtitle: string;
  description: string;
  tags: string[];
}
const { title, subtitle, description, tags } = Astro.props;
---

<div class="lesson-hero">
  <a class="breadcrumb" href="/#atlas">
    Atlas / Replication
  </a>
  <span class="eyebrow">EXPERIMENT 01 · ABOUT 10 MINUTES</span>
  <h1>
    {title} <br />
    <em>{subtitle}</em>
  </h1>
  <p class="lede">{description}</p>
  <div class="lesson-tags">
    {tags.map((tag) => (
      <span>{tag}</span>
    ))}
  </div>
</div>
<noscript>
  <p>
    This experiment needs JavaScript. The explanation and worked scenario below
    are available without it.
  </p>
</noscript>
