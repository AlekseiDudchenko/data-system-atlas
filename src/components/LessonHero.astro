---
import { localeFromPath, localizedPath, translator } from "../i18n";
const locale = localeFromPath(Astro.url.pathname);
const t = translator(locale);
interface Props {
  title: string;
  subtitle: string;
  description: string;
  tags: string[];
  experiment?: string;
  territory?: "Replication" | "Partitioning";
}
const {
  title,
  subtitle,
  description,
  tags,
  experiment = "01",
  territory = "Replication",
} = Astro.props;
---

<div class="lesson-hero">
  <a class="breadcrumb" href={`${localizedPath(locale)}#atlas`}>
    {t("Atlas")} / {t(territory)}
  </a>
  <span class="eyebrow">
    {t("EXPERIMENT {0} · ABOUT 10 MINUTES", experiment)}
  </span>
  <h1>
    {title} <br />
    <em>{subtitle}</em>
  </h1>
  <p class="lede">{description}</p>
  <div class="lesson-tags">
    {tags.map((tag) => (
      <span>{tag}</span>
    ))}
  </div>
</div>
<noscript>
  <p>
    {t(
      "This experiment needs JavaScript. The explanation and worked scenario below are available without it.",
    )}
  </p>
</noscript>
