---
interface Props {
  title: string;
  subtitle: string;
  description: string;
  tags: string[];
  experiment?: string;
  territory?: string;
}
const {
  title,
  subtitle,
  description,
  tags,
  experiment = "01",
  territory = "Replication",
} = Astro.props;
---

<div class="lesson-hero">
  <a class="breadcrumb" href="/#atlas">
    Atlas / {territory}
  </a>
  <span class="eyebrow">EXPERIMENT {experiment} · ABOUT 10 MINUTES</span>
  <h1>
    {title} <br />
    <em>{subtitle}</em>
  </h1>
  <p class="lede">{description}</p>
  <div class="lesson-tags">
    {tags.map((tag) => (
      <span>{tag}</span>
    ))}
  </div>
</div>
<noscript>
  <p>
    This experiment needs JavaScript. The explanation and worked scenario below
    are available without it.
  </p>
</noscript>
