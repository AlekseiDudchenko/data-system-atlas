---
import Layout from "../layouts/Layout.astro";
import MigrationExplorer from "./MigrationExplorer";
import { localeFromPath, localizedPath } from "../i18n";
import { migrationCopy } from "../content/migration";
const locale = localeFromPath(Astro.url.pathname);
const c = migrationCopy[locale];
const category = {
  en: "Data migration",
  ru: "Миграция данных",
  de: "Datenmigration",
}[locale];
---

<Layout title={category} description={c.intro} editorial>
  <div class="migration-story">
    <header class="story-heading">
      <a class="story-back" href={`${localizedPath(locale)}#atlas`}>
        ← {c.back}
      </a>
      <p class="story-kicker">01 — {category}</p>
      <h1>{c.title}</h1>
      <p class="story-intro">{c.intro}</p>
      <p class="story-scroll">↓ {c.scroll}</p>
    </header>
    <noscript>
      <p class="story-noscript">{c.noJs}</p>
    </noscript>
    <MigrationExplorer locale={locale} client:load />
    <section class="story-footnotes">
      <details>
        <summary>{c.boundaries}</summary>
        <p>{c.limits}</p>
      </details>
      <div class="story-sources">
        <h2>{c.sources}</h2>
        <p>{c.sourcesIntro}</p>
        <a href="https://debezium.io/documentation/reference/stable/connectors/postgresql.html#postgresql-snapshots">
          Debezium — snapshots ↗
        </a>
        <a href="https://www.postgresql.org/docs/current/logicaldecoding-explanation.html">
          PostgreSQL — logical decoding ↗
        </a>
      </div>
    </section>
  </div>
</Layout>
