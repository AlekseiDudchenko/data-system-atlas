---
import "../styles/global.css";
import "../styles/editorial.css";
import {
  localeFromPath,
  localizedPath,
  publishedLocales,
  languageNames,
  translator,
} from "../i18n";
const locale = localeFromPath(Astro.url.pathname);
const t = translator(locale);
const canonical = new URL(Astro.url.pathname, Astro.site);
interface Props {
  title?: string;
  frontmatter?: { title: string; description?: string };
  description?: string;
  editorial?: boolean;
}
const title =
  Astro.props.title ?? Astro.props.frontmatter?.title ?? "Data Systems Atlas";
const description =
  Astro.props.description ??
  Astro.props.frontmatter?.description ??
  t(
    "Interactive explorations of how software architectures evolve when workloads grow and simple solutions reach their limits.",
  );
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Apply before paint so saved preferences do not flash the other theme.
      try {
        const saved = localStorage.getItem("atlas-theme");
        if (saved === "light" || saved === "dark") {
          document.documentElement.dataset.theme = saved;
        }
      } catch {
        /* System preference still works when storage is unavailable. */
      }
    </script>
    <meta name="description" content={description} />
    <title>{title} · Data Systems Atlas</title>
    <link rel="canonical" href={canonical} />
    {publishedLocales.length > 1 && publishedLocales.map((language) => (
      <link
        rel="alternate"
        hreflang={language}
        href={new URL(localizedPath(language, Astro.url.pathname), Astro.site)}
      />
    ))}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class:list={{ editorial: Astro.props.editorial }}>
    <a class="skip" href="#main">
      {t("Skip to content")}
    </a>
    <header class="site-header">
      <a class="brand" href={localizedPath(locale)}>
        <span class="brand-icon" aria-hidden="true">
          ◈
        </span>{" "}
        Data Systems Atlas
      </a>
      <nav class="main-nav" aria-label={t("Main")}>
        <a href={`${localizedPath(locale)}#atlas`}>{t("Explore the atlas")}</a>
        <a href="https://github.com/AlekseiDudchenko/data-system-atlas">
          GitHub ↗
        </a>
      </nav>
      <div class="header-preferences">
        {publishedLocales.length > 1 && (
        <nav class="language-switcher" aria-label={t("Language")}>
          {publishedLocales.map((language) => (
            <a
              href={localizedPath(language, Astro.url.pathname)}
              lang={language}
              hreflang={language}
              aria-current={language === locale ? "page" : undefined}
            >
              {languageNames[language]}
            </a>
          ))}
        </nav>
        )}
        <button class="theme-toggle" type="button" aria-pressed="false" hidden>
          <span aria-hidden="true">◐</span>
          {t("Dark theme")}
        </button>
      </div>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer>
      <span>
        Data Systems Atlas · {
          t(
            "No perfect architectures. Only decisions, constraints and consequences.",
          )
        }
      </span>
      <span>{t("An open collection of interactive explorations.")}</span>
    </footer>
  </body>
</html>

<script>
  const toggle = document.querySelector<HTMLButtonElement>(".theme-toggle");
  const systemTheme = window.matchMedia("(prefers-color-scheme: dark)");
  const isDark = () =>
    document.documentElement.dataset.theme
      ? document.documentElement.dataset.theme === "dark"
      : systemTheme.matches;
  const syncToggle = () =>
    toggle?.setAttribute("aria-pressed", String(isDark()));
  if (toggle) {
    syncToggle();
    toggle.hidden = false;
    toggle.addEventListener("click", () => {
      const theme = isDark() ? "light" : "dark";
      document.documentElement.dataset.theme = theme;
      try {
        localStorage.setItem("atlas-theme", theme);
      } catch {
        /* Optional storage. */
      }
      syncToggle();
    });
    systemTheme.addEventListener("change", syncToggle);
  }
</script>
